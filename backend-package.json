{
  "name": "carib-remit-backend",
  "version": "0.1.0",
  "description": "Caribbean Remittance Platform Backend",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src --fix",
    "migrate": "node src/migrations/migrate.js",
    "seed": "node src/seeds/seed.js",
    "build": "echo 'No build needed for Node.js backend'",
    "docker:build": "docker build -t carib-remit-backend .",
    "docker:run": "docker run -p 3000:3000 carib-remit-backend"
  },
  "keywords": [
    "remittance",
    "caribbean",
    "money-transfer",
    "fintech"
  ],
  "author": "CaribRemit Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "dotenv": "^16.0.3",
    "pg": "^8.10.0",
    "redis": "^4.6.5",
    "bcrypt": "^5.1.0",
    "jsonwebtoken": "^9.0.0",
    "joi": "^17.9.2",
    "axios": "^1.4.0",
    "stripe": "^12.0.0",
    "nodemailer": "^6.9.3",
    "twilio": "^3.79.3",
    "date-fns": "^2.30.0",
    "uuid": "^9.0.0",
    "morgan": "^1.10.0",
    "pino": "^8.13.0",
    "sequelize": "^6.32.0",
    "sequelize-cli": "^6.6.0"
  },
  "devDependencies": {
    "nodemon": "^2.0.22",
    "jest": "^29.6.1",
    "supertest": "^6.3.3",
    "eslint": "^8.44.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.27.5"
  }
}
