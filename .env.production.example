# CaribRemit Backend Production Environment Configuration
# DO NOT commit actual values - use AWS Secrets Manager or similar

# ========== APPLICATION ==========
NODE_ENV=production
PORT=3000
API_URL=https://api.caribremit.com/v1
FRONTEND_URL=https://caribremit.com
LOG_LEVEL=info
LOG_FORMAT=json

# ========== DATABASE (PostgreSQL / RDS) ==========
DB_HOST=carib-remit-prod.xxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=carib_remit
DB_USER=postgres
DB_PASSWORD=CHANGE_THIS_IN_AWS_SECRETS_MANAGER
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_SSL=true
DB_LOGGING=false

# ========== CACHE (Redis / ElastiCache) ==========
REDIS_HOST=carib-remit-cache.xxxxxx.ng.0001.use1.cache.amazonaws.com
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_IN_AWS_SECRETS_MANAGER
REDIS_TLS=true
REDIS_DB=0
REDIS_TIMEOUT=5000
CACHE_EXPIRATION_EXCHANGE_RATES=300
CACHE_EXPIRATION_USER_PROFILE=3600

# ========== JWT AUTHENTICATION ==========
JWT_SECRET=CHANGE_THIS_WITH_SECURE_KEY_FROM_SECRETS_MANAGER
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=CHANGE_THIS_WITH_SECURE_KEY_FROM_SECRETS_MANAGER
JWT_REFRESH_EXPIRATION=7d

# ========== SECURITY ==========
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGIN=https://caribremit.com
CORS_CREDENTIALS=true
HELMET_ENABLED=true
HELMET_CSP_ENABLED=true
HELMET_HSTS_MAX_AGE=31536000

# ========== EMAIL SERVICE (AWS SES) ==========
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=CHANGE_THIS_WITH_SES_USERNAME
SMTP_PASSWORD=CHANGE_THIS_WITH_SES_PASSWORD
MAIL_FROM=noreply@caribremit.com
MAIL_FROM_NAME=CaribRemit
SENDGRID_API_KEY=CHANGE_THIS_IF_USING_SENDGRID

# ========== SMS SERVICE (Twilio) ==========
TWILIO_ACCOUNT_SID=CHANGE_THIS_WITH_TWILIO_SID
TWILIO_AUTH_TOKEN=CHANGE_THIS_WITH_TWILIO_TOKEN
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_FROM_NUMBER=+1234567890

# ========== PAYMENT PROCESSORS ==========
# Stripe
STRIPE_SECRET_KEY=sk_live_CHANGE_THIS_WITH_STRIPE_KEY
STRIPE_PUBLIC_KEY=pk_live_CHANGE_THIS_WITH_STRIPE_KEY
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_THIS_WITH_WEBHOOK_SECRET
STRIPE_API_VERSION=2023-10-16

# PayPal
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=CHANGE_THIS_WITH_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=CHANGE_THIS_WITH_PAYPAL_SECRET
PAYPAL_WEBHOOK_ID=CHANGE_THIS_WITH_WEBHOOK_ID

# ========== FILE STORAGE (AWS S3) ==========
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=CHANGE_THIS_WITH_AWS_KEY
AWS_SECRET_ACCESS_KEY=CHANGE_THIS_WITH_AWS_SECRET
AWS_S3_BUCKET=carib-remit-prod-assets
AWS_S3_KYC_FOLDER=kyc-documents
AWS_S3_SIGNATURES_FOLDER=signatures
AWS_CLOUDFRONT_DOMAIN=d123456.cloudfront.net

# ========== EXTERNAL SERVICES ==========
# Foreign Exchange API
FX_API_KEY=CHANGE_THIS_WITH_FX_API_KEY
FX_API_URL=https://api.exchangerate-api.com/v4/latest/

# Cryptocurrency APIs
COINGECKO_API_KEY=CHANGE_THIS_WITH_COINGECKO_KEY
COINGECKO_API_URL=https://api.coingecko.com/api/v3/

# Identity Verification
IDOLOGY_API_KEY=CHANGE_THIS_WITH_IDOLOGY_KEY
IDOLOGY_API_URL=https://api.idology.com/

# Sanctions Screening
OFAC_API_KEY=CHANGE_THIS_WITH_OFAC_KEY

# ========== MONITORING & LOGGING ==========
# Sentry (Error Tracking)
SENTRY_DSN=CHANGE_THIS_WITH_SENTRY_DSN
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=CHANGE_THIS_WITH_VERSION

# New Relic
NEW_RELIC_ENABLED=true
NEW_RELIC_LICENSE_KEY=CHANGE_THIS_WITH_NEW_RELIC_KEY
NEW_RELIC_APP_NAME=CaribRemit-Backend

# DataDog
DATADOG_ENABLED=false
DATADOG_API_KEY=CHANGE_THIS_WITH_DATADOG_KEY

# CloudWatch
CLOUDWATCH_ENABLED=true
CLOUDWATCH_LOG_GROUP=/ecs/carib-remit
CLOUDWATCH_LOG_STREAM=backend

# ========== 2FA & SECURITY ==========
TWO_FACTOR_ENABLED=true
TWO_FACTOR_WINDOW_MS=30000
TOTP_STEP=30

# ========== KYC/AML COMPLIANCE ==========
KYC_ENABLED=true
KYC_VERIFICATION_REQUIRED=true
KYC_DOCUMENT_TYPES=passport,drivers_license,national_id
AML_SCREENING_ENABLED=true
AML_SCREENING_THRESHOLD=5000
TRANSACTION_REPORTING_ENABLED=true

# ========== FEATURE FLAGS ==========
FEATURE_BILLS_PAYMENT=true
FEATURE_CRYPTO_TRADING=true
FEATURE_SCHEDULED_TRANSFERS=true
FEATURE_LOYALTY_REWARDS=true
FEATURE_MOBILE_MONEY=true
FEATURE_CASH_PICKUP=true

# ========== RATE LIMITS & THRESHOLDS ==========
DAILY_TRANSACTION_LIMIT=50000
MONTHLY_TRANSACTION_LIMIT=250000
MAX_RECIPIENTS_PER_USER=50
MAX_TRANSFER_AMOUNT=10000
MIN_TRANSFER_AMOUNT=1

# ========== SCHEDULED JOBS ==========
# Cron expressions for background jobs
SCHEDULED_TRANSFER_JOB_INTERVAL=*/5 * * * *
EXCHANGE_RATE_UPDATE_JOB_INTERVAL=0 */1 * * *
LOYALTY_POINTS_JOB_INTERVAL=0 2 * * *
COMPLIANCE_REPORT_JOB_INTERVAL=0 0 * * 1
DATABASE_BACKUP_JOB_INTERVAL=0 3 * * *

# ========== TIMEOUTS ==========
DATABASE_QUERY_TIMEOUT=10000
API_REQUEST_TIMEOUT=30000
PAYMENT_GATEWAY_TIMEOUT=60000

# ========== DEBUGGING ==========
DEBUG=false
DEBUG_SQL=false
VERBOSE_LOGGING=false
