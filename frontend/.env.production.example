# CaribRemit Frontend Production Environment Configuration

# ========== API CONFIGURATION ==========
VITE_API_URL=https://api.caribremit.com/api/v1
VITE_API_TIMEOUT=30000

# ========== APPLICATION ==========
VITE_APP_NAME=CaribRemit
VITE_APP_VERSION=1.0.0
VITE_NODE_ENV=production

# ========== FEATURE FLAGS ==========
VITE_ENABLE_2FA=true
VITE_ENABLE_BIOMETRIC=true
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_CRYPTO=true
VITE_ENABLE_BILLS_PAYMENT=true
VITE_ENABLE_SCHEDULED_TRANSFERS=true
VITE_ENABLE_LOYALTY_REWARDS=true
VITE_ENABLE_MOBILE_MONEY=true

# ========== ANALYTICS & MONITORING ==========
VITE_SENTRY_DSN=CHANGE_THIS_WITH_SENTRY_DSN
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
VITE_GOOGLE_TAG_MANAGER_ID=GTM-XXXXXXX

# ========== THIRD-PARTY SERVICES ==========
VITE_STRIPE_PUBLIC_KEY=pk_live_CHANGE_THIS
VITE_MAPBOX_ACCESS_TOKEN=CHANGE_THIS_WITH_MAPBOX_TOKEN
VITE_INTERCOM_APP_ID=CHANGE_THIS_WITH_INTERCOM_ID

# ========== UI CONFIGURATION ==========
VITE_THEME_COLOR_PRIMARY=#FF6B6B
VITE_THEME_COLOR_SECONDARY=#4D96FF
VITE_CURRENCY_DISPLAY=symbol
VITE_DATE_FORMAT=DD/MM/YYYY

# ========== PERFORMANCE ==========
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_REPORTING=true
VITE_ENABLE_SESSION_RECORDING=false
VITE_CACHE_STRATEGY=IndexedDB

# ========== SECURITY ==========
VITE_ENABLE_HELMET=true
VITE_ENABLE_CSP=true
VITE_ENABLE_HSTS=true
VITE_CSP_REPORT_URI=https://caribremit.report-uri.com/r/d/csp/reportOnly

# ========== SERVICE WORKER ==========
VITE_ENABLE_SERVICE_WORKER=true
VITE_ENABLE_PWA=true
VITE_PWA_MANIFEST_PATH=/manifest.json

# ========== TIMEOUT & RETRY ==========
VITE_REQUEST_RETRY_ATTEMPTS=3
VITE_REQUEST_RETRY_DELAY=1000
VITE_AUTO_LOGOUT_TIMEOUT=1800000
VITE_SESSION_REFRESH_INTERVAL=300000

# ========== EXTERNAL LINKS ==========
VITE_TERMS_OF_SERVICE_URL=https://caribremit.com/terms
VITE_PRIVACY_POLICY_URL=https://caribremit.com/privacy
VITE_SUPPORT_URL=https://support.caribremit.com
VITE_STATUS_PAGE_URL=https://status.caribremit.com
VITE_BLOG_URL=https://blog.caribremit.com

# ========== CONTACT & SUPPORT ==========
VITE_SUPPORT_EMAIL=support@caribremit.com
VITE_SUPPORT_PHONE=+1-888-CARIBREMIT
VITE_SUPPORT_LIVE_CHAT_ENABLED=true
VITE_INTERCOM_ENABLED=true

# ========== GEOLOCATION ==========
VITE_ALLOWED_COUNTRIES=JM,KY,TT,BS,AG,LC,VC,GD,DM,KN,VG
VITE_DEFAULT_COUNTRY=JM
VITE_DEFAULT_CURRENCY=USD

# ========== PAYMENT METHODS ==========
VITE_PAYMENT_METHODS_ENABLED=card,bank_transfer,mobile_money,cash_pickup
VITE_SUPPORTED_CARD_TYPES=visa,mastercard,amex

# ========== COMPLIANCE ==========
VITE_AGE_VERIFICATION_REQUIRED=true
VITE_MIN_AGE=18
VITE_KYC_VERIFICATION_REQUIRED=true
VITE_TERMS_ACCEPTANCE_REQUIRED=true

# ========== TESTING & DEBUGGING (should be false in production) ==========
VITE_DEBUG=false
VITE_MOCK_API=false
VITE_ENABLE_DEV_TOOLS=false
